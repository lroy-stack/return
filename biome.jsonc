{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!src/worker/worker-configuration.d.ts", "!**/dist", "!**/.wrangler", "!.claude"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      // Icon/illustration sources are decorative building blocks compiled by scripts/build-icons.ts, and
      // public/p/icons.svg is its generated <symbol> sprite (never rendered on its own). The accessible name is
      // applied where they are used (Icon, ItemArt, finder <svg aria-hidden>), so a <title> would be wrong.
      "includes": ["src/assets/**/*.svg", "public/p/icons.svg"],
      "linter": { "rules": { "a11y": { "noSvgWithoutTitle": "off" } } }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
