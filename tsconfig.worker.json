{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "lib": ["ES2023"],
    "types": ["./src/worker/worker-configuration.d.ts", "@cloudflare/vitest-plugin/types"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  },
  "include": [
    "src/worker",
    "src/shared",
    "src/app/lib/format.ts",
    "src/app/lib/settings-patch.ts",
    "src/app/ui/select-logic.ts",
    "src/app/ui/icons.generated.ts",
    "src/app/ui/item-art.generated.ts",
    "vite/icons.ts",
    "test"
  ]
}
