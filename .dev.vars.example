TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
IP_HMAC_SECRET=dev-only-not-secret
ENVIRONMENT=development
DEV_OWNER_EMAIL=owner@example.test
TURNSTILE_SITE_KEY=1x00000000000000000000AA
FALLBACK_CONTACT_EMAIL=backup@example.test
# Local dev serves both surfaces on localhost: never use the production hosts here.
PUBLIC_HOST=
APP_HOST=
# Answer geocoding in-process in local dev/E2E (never calls OpenStreetMap).
NOMINATIM_STUB=1
# Web Push (optional): generate a pair with `node scripts/vapid-keys.mjs --out vapid-private.key`
# (prints the public key), then paste both here. Never commit real values.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
